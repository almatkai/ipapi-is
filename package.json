{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "ipapi-is",
  "title": "ipapi.is",
  "description": "Lookup IP or ASN via ipapi.is",
  "icon": "ipapi-is.png",
  "author": "almatkai",
  "categories": [
    "Data"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "lookup-ip-or-asn",
      "title": "Lookup IP or ASN",
      "subtitle": "ipapi.is",
      "description": "Lookup IP or ASN",
      "mode": "view",
      "arguments": [
        {
          "name": "ip",
          "placeholder": "IP_OR_ASN",
          "required": false,
          "type": "text"
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.ipapi-is",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/ipapi-is",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/ipapi-is",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
